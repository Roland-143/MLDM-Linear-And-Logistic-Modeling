# Virtual environments and Python cache
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Keep data and model folders, avoid committing generated artifacts
/data/raw/*.csv
/data/processed/*
!/data/processed/.gitkeep
/models/*
!/models/.gitkeep
/results/figures/*
!/results/figures/.gitkeep
/results/*.json

# Reproducible Tableau extracts generated by `python -m src.member1_prepare`.
# Keep the packaged workbook in Git, but regenerate these data exports locally.
/tableau/correlations.csv
/tableau/data_quality.json
/tableau/house_sales_tableau.csv
/tableau/missing_values.csv
/tableau/price_histogram.csv
/tableau/quality_summary.csv
/tableau/zipcode_summary.csv

# Videos and optional working slides
/deliverables/*
!/deliverables/.gitkeep
