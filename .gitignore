# Virtual environments and Python cache
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# The public processed datasets are versioned; raw downloads and trained models
# are regenerated locally.
/data/raw/*.csv
/models/*
!/models/.gitkeep

# Tableau extracts generated by `python -m src.prepare_data` are versioned.

# Large submission files remain local.
/deliverables/*
!/deliverables/.gitkeep
!/deliverables/README.md
